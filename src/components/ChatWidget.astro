---
// LINE Chat Widget for JJ Com Solar Cell
// Opens LINE app/web with pre-filled message
interface Props {
  lineId?: string;
  phone?: string;
}

const { lineId = "mamatommassage2019", phone = "+66940509623" } = Astro.props;
---

<!-- Floating Chat Widget -->
<div id="chat-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
  
  <!-- Chat Options Panel (hidden by default) -->
  <div id="chat-options" class="hidden flex-col gap-3 mb-2 transition-all duration-300">
    
    <!-- LINE Chat -->
    <a 
      href={`https://line.me/ti/p/~${lineId}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 bg-[#06C755] text-white px-4 py-3 rounded-full shadow-lg hover:bg-[#05B04D] transition-all transform hover:scale-105"
    >
      <svg class="w-6 h-6" fill="white" viewBox="0 0 24 24">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-2h2v2zm0-4h-2V7h2v6zm4 4h-2v-2h2v2zm0-4h-2V7h2v6z"/>
      </svg>
      <span class="font-medium text-sm">Chat on LINE</span>
    </a>
    
    <!-- Phone Call -->
    <a 
      href={`tel:${phone}`}
      class="flex items-center gap-3 bg-solar-yellow text-solar-dark px-4 py-3 rounded-full shadow-lg hover:bg-yellow-400 transition-all transform hover:scale-105"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      <span class="font-medium text-sm">Call Now</span>
    </a>
    
    <!-- QR Code (shown when image is available) -->
    <div id="qr-code-section" class="hidden bg-white p-3 rounded-xl shadow-lg">
      <p class="text-xs text-gray-600 mb-2 text-center">Scan to add on LINE</p>
      <img 
        src="/images/line-qr-code.jpg" 
        alt="LINE QR Code for JJ Com Solar Cell"
        class="w-32 h-32 mx-auto"
        loading="lazy"
        onerror="this.parentElement.style.display='none'"
      />
      <p class="text-xs text-gray-500 mt-1 text-center">ID: {lineId}</p>
    </div>
  </div>
  
  <!-- Main Toggle Button -->
  <button 
    id="chat-toggle"
    class="w-14 h-14 bg-solar-green text-white rounded-full shadow-lg hover:bg-green-600 transition-all transform hover:scale-110 flex items-center justify-center"
    aria-label="Open chat options"
  >
    <svg id="chat-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
    </svg>
    <svg id="close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
</div>

<script>
  const chatToggle = document.getElementById('chat-toggle');
  const chatOptions = document.getElementById('chat-options');
  const chatIcon = document.getElementById('chat-icon');
  const closeIcon = document.getElementById('close-icon');
  
  let isOpen = false;
  
  chatToggle.addEventListener('click', () => {
    isOpen = !isOpen;
    if (isOpen) {
      chatOptions.classList.remove('hidden');
      chatOptions.classList.add('flex');
      chatIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    } else {
      chatOptions.classList.add('hidden');
      chatOptions.classList.remove('flex');
      chatIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  });
  
  // Close when clicking outside
  document.addEventListener('click', (e) => {
    if (!document.getElementById('chat-widget').contains(e.target) && isOpen) {
      chatToggle.click();
    }
  });
</script>
