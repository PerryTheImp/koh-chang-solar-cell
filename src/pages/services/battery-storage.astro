---
import Layout from '../../layouts/Layout.astro';
const title = 'Battery Storage Systems Thailand | Solar Batteries | JJ Com Solar Cell';
const description = 'Store excess solar energy for night use and backup power. Lithium-ion and LiFePO4 battery systems for homes and businesses across Thailand. Free quote.';
---
<Layout
  title={title}
  description={description}
  ogType="website"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Solar Battery Storage Systems",
    "provider": { "@type": "Organization", "name": "JJ Com Solar Cell" },
    "areaServed": { "@type": "Country", "name": "Thailand" }
  }}
>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-solar-green">Home</a> / <span>Services</span> / <span>Battery Storage</span>
    </nav>

    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-solar-yellow/20 text-solar-yellow px-4 py-2 rounded-full text-sm font-medium mb-6">
        Serving Thailand Since 2016
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Battery Storage Systems</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Store excess solar energy for night use, backup power during outages, and energy independence.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-12">
      <div class="bg-gray-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-solar-green mb-2">24/7</div>
        <div class="text-sm text-gray-600">Power available day and night</div>
      </div>
      <div class="bg-gray-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-solar-green mb-2">Zero</div>
        <div class="text-sm text-gray-600">Grid dependency possible</div>
      </div>
      <div class="bg-gray-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-solar-green mb-2">5-15</div>
        <div class="text-sm text-gray-600">Years battery lifespan</div>
      </div>
    </div>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">Battery Options We Install</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
          <h3 class="font-bold mb-2">Lithium-Ion (Li-ion)</h3>
          <p class="text-sm text-gray-600">High energy density, compact size, fast charging. Best for homes with limited space.</p>
        </div>
        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
          <h3 class="font-bold mb-2">LiFePO4 (Lithium Iron Phosphate)</h3>
          <p class="text-sm text-gray-600">Longer lifespan, safer chemistry, better heat tolerance. Ideal for Thailand's tropical climate.</p>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">Benefits of Solar Battery Storage</h2>
      <ul class="space-y-3">
        <li class="flex items-start gap-2"><span class="text-solar-green">✓</span> <span><strong>Energy independence:</strong> Reduce reliance on the grid and rising electricity tariffs</span></li>
        <li class="flex items-start gap-2"><span class="text-solar-green">✓</span> <span><strong>Backup power:</strong> Keep lights and appliances running during outages</span></li>
        <li class="flex items-start gap-2"><span class="text-solar-green">✓</span> <span><strong>Maximize solar:</strong> Store daytime surplus for evening use instead of selling back at low rates</span></li>
        <li class="flex items-start gap-2"><span class="text-solar-green">✓</span> <span><strong>Off-grid capability:</strong> Complete energy autonomy for remote locations</span></li>
      </ul>
    </section>

    <section class="bg-gradient-to-br from-slate-50 to-blue-50 rounded-xl p-8 mb-12">
      <h2 class="text-2xl font-bold mb-4">Related Resources</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/guides/solar-system-sizing" class="bg-white p-4 rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-100">
          <div class="font-bold">System Sizing Calculator</div>
          <div class="text-sm text-gray-600">Size your system with battery storage included</div>
        </a>
        <a href="/guides/solar-panels-cloudy-days" class="bg-white p-4 rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-100">
          <div class="font-bold">Cloudy Day Performance</div>
          <div class="text-sm text-gray-600">How batteries help during low-generation periods</div>
        </a>
      </div>
    </section>

    <div class="bg-solar-green text-white rounded-xl p-8 text-center">
      <h2 class="text-2xl font-bold mb-2">Ready for Energy Independence?</h2>
      <p class="mb-6">Get a free battery storage assessment and quote.</p>
      <a href="/#contact" class="inline-block bg-white text-solar-green font-semibold px-8 py-3 rounded-lg hover:bg-gray-100 transition-colors">
        Get a Free Quote
      </a>
    </div>
  </article>
</Layout>
