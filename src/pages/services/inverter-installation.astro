---
import Layout from '../../layouts/Layout.astro';
const title = 'Solar Inverter Installation Thailand | Grid-Tie, Hybrid, Off-Grid | JJ Com Solar Cell';
const description = 'Professional solar inverter installation in Thailand. Grid-tie, hybrid, and off-grid inverters from Deye, Sofar, and leading brands. 10+ years experience.';
---
<Layout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-solar-green">Home</a> / <span>Services</span> / <span>Inverter Installation</span>
    </nav>

    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-solar-yellow/20 text-solar-yellow px-4 py-2 rounded-full text-sm font-medium mb-6">
        Serving Thailand Since 2016
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Solar Inverter Installation</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Grid-tie, hybrid, and off-grid inverters from leading manufacturers including Deye and Sofar.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-12">
      <div class="bg-gray-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-solar-green mb-2">Grid-Tie</div>
        <div class="text-sm text-gray-600">Export excess to grid</div>
      </div>
      <div class="bg-gray-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-solar-green mb-2">Hybrid</div>
        <div class="text-sm text-gray-600">Grid + battery backup</div>
      </div>
      <div class="bg-gray-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-solar-green mb-2">Off-Grid</div>
        <div class="text-sm text-gray-600">Complete independence</div>
      </div>
    </div>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">Brands We Install</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
          <h3 class="font-bold mb-2">Deye Inverters</h3>
          <p class="text-sm text-gray-600">High-efficiency hybrid inverters with smart monitoring. Excellent for residential and commercial systems in Thailand.</p>
        </div>
        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
          <h3 class="font-bold mb-2">Sofar Inverters</h3>
          <p class="text-sm text-gray-600">Reliable grid-tie and hybrid solutions. Strong performance in high-temperature environments.</p>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">Inverter Types Explained</h2>
      <div class="space-y-4">
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">String Inverters</h3>
          <p class="text-sm text-gray-600">Cost-effective for unshaded roofs. Multiple panels connected in series.</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Microinverters</h3>
          <p class="text-sm text-gray-600">One per panel. Better for shaded roofs and granular monitoring.</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Hybrid Inverters</h3>
          <p class="text-sm text-gray-600">Combines solar and battery management. Future-proof your system.</p>
        </div>
      </div>
    </section>

    <div class="bg-solar-green text-white rounded-xl p-8 text-center">
      <h2 class="text-2xl font-bold mb-2">Need a New Inverter?</h2>
      <p class="mb-6">Get a free assessment and quote for your inverter installation or replacement.</p>
      <a href="/#contact" class="inline-block bg-white text-solar-green font-semibold px-8 py-3 rounded-lg hover:bg-gray-100 transition-colors">
        Get a Free Quote
      </a>
    </div>
  </article>
</Layout>
