---
import Layout from '../../layouts/Layout.astro';
const title = 'Solar Racking & Mounting Thailand | Roof & Ground Mount | JJ Com Solar Cell';
const description = 'Professional solar racking and mounting systems in Thailand. Corrosion-resistant aluminium for tropical climates. Rooftop, ground, and carport installations.';
---
<Layout
  title={title}
  description={description}
  ogType="website"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Solar Racking \u0026 Mounting Systems",
    "provider": { "@type": "Organization", "name": "JJ Com Solar Cell" },
    "areaServed": { "@type": "Country", "name": "Thailand" }
  }}
>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-solar-green">Home</a> / <span>Services</span> / <span>Racking & Mounting</span>
    </nav>

    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-solar-yellow/20 text-solar-yellow px-4 py-2 rounded-full text-sm font-medium mb-6">
        Serving Thailand Since 2016
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Racking & Mounting Systems</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Professional mounting systems engineered for Thailand's tropical climate. Corrosion-resistant aluminium for rooftop and ground installations.
      </p>
    </div>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">Mounting Options</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Rooftop Mount</h3>
          <p class="text-sm text-gray-600">Tile roof, metal roof, and flat roof systems with proper waterproofing.</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Ground Mount</h3>
          <p class="text-sm text-gray-600">Adjustable tilt for optimal sun angles. Ideal for large properties.</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Carport Structure</h3>
          <p class="text-sm text-gray-600">Dual-purpose shade and power generation. Popular for commercial sites.</p>
        </div>
      </div>
    </section>

    <div class="bg-solar-green text-white rounded-xl p-8 text-center">
      <h2 class="text-2xl font-bold mb-2">Need Mounting Solutions?</h2>
      <p class="mb-6">Get a free assessment for your roof or ground mount installation.</p>
      <a href="/#contact" class="inline-block bg-white text-solar-green font-semibold px-8 py-3 rounded-lg hover:bg-gray-100 transition-colors">
        Get a Free Quote
      </a>
    </div>
  </article>
</Layout>
