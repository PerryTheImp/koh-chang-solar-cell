---
import Layout from '../../layouts/Layout.astro';
const title = 'Solar Panel Cleaning Thailand | 300 THB Per Panel | JJ Com Solar Cell';
const description = 'Professional solar panel cleaning across Thailand. 300 THB per panel + travel. Dust, bird dropping, and monsoon residue removal. Maximize system efficiency.';
---
<Layout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-solar-green">Home</a> / <span>Services</span> / <span>Panel Cleaning</span>
    </nav>

    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-solar-yellow/20 text-solar-yellow px-4 py-2 rounded-full text-sm font-medium mb-6">
        Serving Thailand Since 2016
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Solar Panel Cleaning & Maintenance</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Professional cleaning at 300 THB per panel plus travel. Remove dust, bird droppings, and monsoon residue to maintain peak efficiency.
      </p>
    </div>

    <div class="bg-solar-green/5 rounded-xl p-6 mb-12">
      <div class="grid md:grid-cols-3 gap-4 text-center">
        <div>
          <div class="text-3xl font-bold text-solar-green">300 THB</div>
          <div class="text-sm text-gray-600">Per panel + travel</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-solar-green">15-25%</div>
          <div class="text-sm text-gray-600">Efficiency gain after cleaning</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-solar-green">1 Year</div>
          <div class="text-sm text-gray-600">Free maintenance included</div>
        </div>
      </div>
    </div>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">What's Included</h2>
      <ul class="space-y-3">
        <li class="flex items-start gap-2"><span class="text-solar-green">✓</span> <span><strong>Visual inspection:</strong> Crack, chip, and hotspot check</span></li>
        <li class="flex items-start gap-2"><span class="text-solar-green">✓</span> <span><strong>Soft brush cleaning:</strong> No scratches or damage</span></li>
        <li class="flex items-start gap-2"><span class="text-solar-green">✓</span> <span><strong>Deionized water rinse:</strong> No mineral residue</span></li>
        <li class="flex items-start gap-2"><span class="text-solar-green">✓</span> <span><strong>Performance test:</strong> Before and after output comparison</span></li>
      </ul>
    </section>

    <section class="bg-gradient-to-br from-slate-50 to-blue-50 rounded-xl p-8 mb-12">
      <h2 class="text-2xl font-bold mb-4">Related Resources</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/guides/solar-panel-maintenance" class="bg-white p-4 rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-100">
          <div class="font-bold">Maintenance & Cleaning Guide</div>
          <div class="text-sm text-gray-600">DIY cleaning tips and schedules</div>
        </a>
      </div>
    </section>

    <div class="bg-solar-green text-white rounded-xl p-8 text-center">
      <h2 class="text-2xl font-bold mb-2">Book Your Cleaning Service</h2>
      <p class="mb-6">Restore your panels to peak performance. 300 THB per panel + travel.</p>
      <a href="/#contact" class="inline-block bg-white text-solar-green font-semibold px-8 py-3 rounded-lg hover:bg-gray-100 transition-colors">
        Book Now
      </a>
    </div>
  </article>
</Layout>
