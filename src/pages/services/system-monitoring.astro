---
import Layout from '../../layouts/Layout.astro';
const title = 'Solar System Monitoring Thailand | Smart Energy Tracking | JJ Com Solar Cell';
const description = 'Smart solar monitoring systems for Thailand. Track energy production, consumption, and savings in real-time via smartphone apps. Professional installation.';
---
<Layout
  title={title}
  description={description}
  ogType="website"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Solar System Monitoring",
    "provider": { "@type": "Organization", "name": "JJ Com Solar Cell" },
    "areaServed": { "@type": "Country", "name": "Thailand" }
  }}
>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-solar-green">Home</a> / <span>Services</span> / <span>System Monitoring</span>
    </nav>

    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-solar-yellow/20 text-solar-yellow px-4 py-2 rounded-full text-sm font-medium mb-6">
        Serving Thailand Since 2016
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">System Monitoring</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Smart monitoring apps to track your energy production, consumption, and savings in real-time.
      </p>
    </div>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">What You Can Track</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Real-Time Production</h3>
          <p class="text-sm text-gray-600">See exactly how much energy your panels are generating right now.</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Historical Data</h3>
          <p class="text-sm text-gray-600">Daily, weekly, monthly, and yearly production charts.</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Fault Detection</h3>
          <p class="text-sm text-gray-600">Automatic alerts when a panel or inverter underperforms.</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h3 class="font-bold mb-2">Savings Calculator</h3>
          <p class="text-sm text-gray-600">Track cumulative savings vs. your old electricity bills.</p>
        </div>
      </div>
    </section>

    <div class="bg-solar-green text-white rounded-xl p-8 text-center">
      <h2 class="text-2xl font-bold mb-2">Start Monitoring Your System</h2>
      <p class="mb-6">Get smart monitoring installed with your solar system.</p>
      <a href="/#contact" class="inline-block bg-white text-solar-green font-semibold px-8 py-3 rounded-lg hover:bg-gray-100 transition-colors">
        Get a Free Quote
      </a>
    </div>
  </article>
</Layout>
