              break;
            case 'human':
              addMessage('\uD83D\uDCDE \u0E15\u0E34\u0E14\u0E15\u0E48\u0E2D\u0E40\u0E23\u0E32\u0E42\u0E14\u0E22\u0E15\u0E23\u0E07:\u003cbr\u003e\uD83D\uDCF1 \u0E42\u0E17\u0E23: \u003ca href="tel:+66940509623"\u003e' + PHONE + '\u003c/a\u003e\u003cbr\u003e\uD83D\uDCE7 \u0E2D\u0E35\u0E40\u0E21\u0E25: ' + EMAIL + '\u003cbr\u003e\uD83D\uDCAC LINE: \u003ca href="https://line.me/ti/p/~' + LINE_ID + '" target="_blank"\u003e@' + LINE_ID + '\u003c/a\u003e');
              break;
          }
        });
      });
      
      function sendMessage() {
        var text = input.value.trim();
        if (!text) return;
        addMessage(text, true);
        input.value = '';
        if (options) options.style.display = 'none';
        showTyping(function() {
          addMessage('\uD83D\uDE0A \u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E02\u0E49\u0E2D\u0E04\u0E27\u0E32\u0E21\u0E04\u0E48\u0E30! \u0E40\u0E23\u0E32\u0E08\u0E30\u0E2A\u0E48\u0E07\u0E15\u0E48\u0E2D\u0E43\u0E2B\u0E49\u0E17\u0E35\u0E21\u0E07\u0E32\u0E19\u0E41\u0E25\u0E30\u0E15\u0E2D\u0E1A\u0E01\u0E25\u0E31\u0E1A\u0E42\u0E14\u0E22\u0E40\u0E23\u0E47\u0E27\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14\u0E04\u0E48\u0E30\u003cbr\u003e\u003cbr\u003e\u0E2B\u0E23\u0E37\u0E2D \u003ca href="https://line.me/ti/p/~' + LINE_ID + '" target="_blank"\u003e\u0E04\u0E25\u0E34\u0E01\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E04\u0E38\u0E22\u0E1A\u0E19 LINE (@' + LINE_ID + ')\u003c/a\u003e \u0E15\u0E2D\u0E1A\u0E40\u0E23\u0E47\u0E27\u0E01\u0E27\u0E48\u0E32\u0E04\u0E48\u0E30');
        });
      }
      
      document.getElementById('chat-send').onclick = sendMessage;
      input.addEventListener('keypress', function(e) { if (e.key === 'Enter') sendMessage(); });
    });
  </script>
