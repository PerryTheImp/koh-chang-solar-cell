---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  lang?: string;
}
const { title, description = 'JJ Com Solar Cell - Complete solar system installation and care in Thailand since 2016', lang = 'en' } = Astro.props;

const isThai = lang === 'th';
const alternateLang = isThai ? 'en' : 'th';
const alternatePath = isThai ? '/' : '/th/';
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="alternate" hreflang={lang} href={Astro.url.pathname} />
  <link rel="alternate" hreflang={alternateLang} href={alternatePath} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "JJ Com Solar Cell",
    "image": "https://kohchangsolarcell.com/images/logo.jpg",
    "telephone": "+66940509623",
    "email": "jjcomandsolarcell@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "113/10 Moo 4",
      "addressLocality": "Ko Chang District",
      "addressRegion": "Trat",
      "postalCode": "23170",
      "addressCountry": "TH"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 12.0,
      "longitude": 102.3
    },
    "url": "https://kohchangsolarcell.com",
    "priceRange": "$$",
    "areaServed": {
      "@type": "Country",
      "name": "Thailand"
    },
    "serviceType": [
      "Solar Panel Installation",
      "Solar System Maintenance",
      "Solar Panel Cleaning",
      "Solar Battery Storage",
      "Solar Inverter Installation"
    ],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  }
  </script>
</head>
<body class="bg-white text-gray-900 antialiased">
  <!-- Sticky Phone Bar -->
  <div class="sticky-phone bg-solar-green text-white py-2 px-4 shadow-md">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2 text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <span class="font-medium">{isThai ? 'โทรเลย:' : 'Call now:'} <a href="tel:+66940509623" class="underline hover:text-yellow-200 transition-colors">094 050 9623</a></span>
      </div>
      <a href={alternatePath} class="text-xs bg-white/20 hover:bg-white/30 px-3 py-1 rounded-full transition-colors">
        {isThai ? 'English' : 'ไทย'}
      </a>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="mt-10 bg-white border-b border-gray-100 sticky top-0 z-40 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href={isThai ? '/th/' : '/'} class="flex items-center gap-2">
        <div class="w-10 h-10 bg-solar-yellow rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-solar-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <div>
          <span class="font-bold text-lg text-solar-dark leading-tight block">JJ Com Solar Cell</span>
          <span class="text-xs text-gray-500">{isThai ? 'ระบบพลังงานแสงอาทิตย์' : 'Solar Energy Systems'}</span>
        </div>
      </a>
      <div class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href={isThai ? '/th/#services' : '/#services'} class="hover:text-solar-green transition-colors">{isThai ? 'บริการ' : 'Services'}</a>
        <a href={isThai ? '/th/#products' : '/#products'} class="hover:text-solar-green transition-colors">{isThai ? 'ผลิตภัณฑ์' : 'Products'}</a>
        <a href={isThai ? '/th/#about' : '/#about'} class="hover:text-solar-green transition-colors">{isThai ? 'เกี่ยวกับเรา' : 'About'}</a>
        <a href={isThai ? '/th/#contact' : '/#contact'} class="bg-solar-green text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors">{isThai ? 'ขอใบเสนอราคา' : 'Get a Quote'}</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-solar-dark text-gray-300 py-12 mt-20">
    <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-4 gap-8">
      <div>
        <h3 class="text-white font-bold text-lg mb-4">JJ Com Solar Cell</h3>
        <p class="text-sm mb-4">{isThai ? 'ติดตั้งและดูแลระบบพลังงานแสงอาทิตย์ครบวงจรในประเทศไทย ตั้งแต่ปี 2016' : 'Complete solar system installation and care in Thailand since 2016'}</p>
        <div class="flex items-center gap-2 text-sm">
          <svg class="w-4 h-4 text-solar-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>113/10 Moo 4, Ko Chang District, Trat 23170, Thailand</span>
        </div>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-4">{isThai ? 'บริการ' : 'Services'}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#" class="hover:text-solar-yellow transition-colors">{isThai ? 'ติดตั้งแผงโซลาร์เซลล์' : 'Solar Panel Installation'}</a></li>
          <li><a href="#" class="hover:text-solar-yellow transition-colors">{isThai ? 'ระบบเก็บพลังงาน' : 'Battery Storage Systems'}</a></li>
          <li><a href="#" class="hover:text-solar-yellow transition-colors">{isThai ? 'อินเวอร์เตอร์' : 'Inverter Installation'}</a></li>
          <li><a href="#" class="hover:text-solar-yellow transition-colors">{isThai ? 'ทำความสะอาดแผง' : 'Panel Cleaning'}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-4">{isThai ? 'ผลิตภัณฑ์' : 'Products'}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#" class="hover:text-solar-yellow transition-colors">{isThai ? 'แผงโซลาร์เซลล์' : 'Solar Panels'}</a></li>
          <li><a href="#" class="hover:text-solar-yellow transition-colors">{isThai ? 'อินเวอร์เตอร์' : 'Solar Inverters'}</a></li>
          <li><a href="#" class="hover:text-solar-yellow transition-colors">{isThai ? 'ระบบยึดติด' : 'Mounting Systems'}</a></li>
          <li><a href="#" class="hover:text-solar-yellow transition-colors">{isThai ? 'แบตเตอรี่' : 'Battery Storage'}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-4">{isThai ? 'ติดต่อเรา' : 'Contact Us'}</h4>
        <ul class="space-y-2 text-sm">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-solar-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <a href="tel:+66940509623" class="hover:text-solar-yellow transition-colors">094 050 9623</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-solar-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:jjcomandsolarcell@gmail.com" class="hover:text-solar-yellow transition-colors">jjcomandsolarcell@gmail.com</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 mt-8 pt-8 border-t border-gray-700 text-xs text-center">
      &copy; 2026 JJ Com Solar Cell. {isThai ? 'สงวนลิขสิทธิ์' : 'All rights reserved.'}
    </div>
  </footer>
</body>
</html>
